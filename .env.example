# ─────────────────────────────────────────────────────────────────
# BioLens — .env.example
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env to Git!
# ─────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────
APP_NAME=BioLens
DEBUG=false

# ── Security ──────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-strong-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database ──────────────────────────────────────────────────────
# Supabase PostgreSQL connection string (from Supabase dashboard → Settings → Database)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres

# ── Cloudinary ───────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── HuggingFace ──────────────────────────────────────────────────
# Uncomment to route inference to your HF Space instead of local PyTorch
# HF_SPACE_URL=https://your-hf-username-your-space-name.hf.space

# ── Frontend CORS ─────────────────────────────────────────────────
# Local dev
FRONTEND_URL=http://localhost:3000
# Production (your Vercel domain)
# FRONTEND_URL=https://your-app.vercel.app
